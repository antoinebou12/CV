.lychee-deploy-verify/
_site_hugo_test/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.tycache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
*.egg-info/
.eggs/
dist/
/build/

# Local virtual environments
.venv/
venv/
env/

# Local secrets (never commit)
.env
.env.*
!.env.example

# Node (Playwright UX audit and other local tooling)
node_modules/
tools/ux-audit/playwright-report/
tools/ux-audit/test-results/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE (machine-local)
.idea/
.vscode/
*.swp
*.swo
*~

# Runtime logs (not site source)
/logs/

# Local Hugo / deploy verify output (CI builds _site on the runner only)
/_site/
/_test_site/

# Figurines post: export GLBs locally (ComfyUI mesh/), not in git
hugo/content/posts/ai-figurines-3d-printing/models/*.glb

# Windows reserved device name; accidental creation breaks `git add`.
/NUL

# Cursor local state (machine/session specific)
/.cursor/hooks/state/

# OpenAI Codex local workspace data
/.codex/

# Thesis PDFs stay private and outside the published repository
/hugo/content/posts/graphquon-2025-university-of-toronto/*.pdf
/hugo/content/posts/thesis-wear-texture-space/images/*.pdf

# LaTeX build artifacts (cv-en, cv-fr, letters)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex.gz
*.xdv
*.toc
*.lof
*.lot

# Build/editor logs and temp files
*.log
*.tmp
*.temp

# Local scratch output (e2e staging site, review captures)
/tmp/

# Temporary Hugo and review builds (contain decks over the 100 MB GitHub limit)
/_site_loop/
/.tmp-responsive/
/hugo/tmp-hugo-*/

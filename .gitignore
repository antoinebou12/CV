.lychee-deploy-verify/
_site_hugo_test/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.tycache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
*.egg-info/
.eggs/
dist/
build/

# Local virtual environments
.venv/
venv/
env/

# Local secrets (never commit)
.env
.env.*
!.env.example

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE (machine-local)
.idea/
.vscode/
*.swp
*.swo
*~

# Local Hugo / deploy verify output (CI builds _site on the runner only)
/_site/
/_test_site/

# Windows reserved device name; accidental creation breaks `git add`.
/NUL

# Cursor local state (machine/session specific)
/.cursor/hooks/state/

# OpenAI Codex local workspace data
/.codex/

# LaTeX build artifacts (cv-en, cv-fr, letters)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex.gz
*.xdv
*.toc
*.lof
*.lot

# Build/editor logs and temp files
*.log
*.tmp
*.temp

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["person", "skills", "skill_groups"],
  "properties": {
    "person": {
      "type": "object",
      "required": ["name", "position"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "position": {
          "type": "object",
          "required": ["en", "fr"],
          "properties": {
            "en": { "type": "string" },
            "fr": { "type": "string" }
          }
        },
        "email": { "type": "string" },
        "github": { "type": "string" },
        "linkedin": { "type": "string" }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "label": {
            "type": "object",
            "properties": { "en": { "type": "string" }, "fr": { "type": "string" } }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": {
            "type": "object",
            "required": ["en", "fr"],
            "properties": { "en": { "type": "string" }, "fr": { "type": "string" } }
          },
          "url": { "type": "string" },
          "level": { "type": "string", "enum": ["advanced", "intermediate", "note"] }
        }
      }
    },
    "skill_groups": {
      "type": "object",
      "required": ["latex_en", "latex_fr"],
      "properties": {
        "latex_en": { "$ref": "#/$defs/skillGroupList" },
        "latex_fr": { "$ref": "#/$defs/skillGroupList" },
        "html_en": { "$ref": "#/$defs/skillGroupList" },
        "html_fr": { "$ref": "#/$defs/skillGroupList" }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bullets"],
        "properties": {
          "id": { "type": "string" },
          "bullets": {
            "type": "object",
            "properties": { "en": { "type": "array" }, "fr": { "type": "array" } }
          }
        }
      }
    }
  },
  "$defs": {
    "skillGroupList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category"],
        "properties": {
          "category": { "type": "string" },
          "latex_line": { "type": "string" },
          "generated": { "type": "string", "enum": ["certifications"] },
          "skill_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "intermediate_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}

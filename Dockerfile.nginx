# Dockerfile for Nginx Static Site Serving
FROM nginx:alpine@sha256:7fc0fb4af7bf006aeb31aea88069976060f8f0a0a86b667126742cc17f4e31ae

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Each service mounts its own server config and site files in docker-compose.
# Copying every config here made cv-site.conf the default server in every
# container, so the linktree container served the whole repository.

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

node_client(("AI Client"))
node_kroki_service["Kroki Service"]

node_client -->|"requests tools"| node_mcp_server
node_mcp_server -->|"registers tools"| node_diagram_tools
node_diagram_tools -->|"validates input"| node_validation
node_diagram_tools -->|"requests generation"| node_diagram_service
node_diagram_service -->|"generates diagram"| node_rendering
node_diagram_service -->|"reads and writes"| node_render_cache
node_rendering -->|"renders source"| node_kroki
node_kroki -.->|"sends render request"| node_kroki_service
node_diagram_service -->|"builds display output"| node_delivery
node_diagram_tools -->|"lists diagram types"| node_catalog
node_mcp_server -->|"registers prompts"| node_prompts
node_mcp_server -->|"registers resources"| node_resources
node_mcp_server -.->|"serves event interface"| node_agui
node_console_ui -.->|"uses console API"| node_admin_api
node_admin_api -->|"reads and saves"| node_admin_settings
node_admin_api -->|"adds Kroki routes"| node_kroki_admin
node_kroki_admin -->|"renders playground"| node_diagram_service
node_enterprise_auth -.->|"protects requests"| node_mcp_server
node_admin_api -->|"records operations"| node_audit
node_mcp_server -->|"loads plugins"| node_plugin_loader
node_plugin_loader -.->|"routes plugin types"| node_kroki


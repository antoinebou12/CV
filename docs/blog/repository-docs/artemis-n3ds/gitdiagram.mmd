node_renderer -->|"uses graphics lifecycle"| node_graphics
node_connection -.->|"streams audio"| node_audio
node_user -->|"views or saves metrics"| node_telemetry
node_user -->|"views performance"| node_benchmark
node_main -->|"uses telemetry store"| node_telemetry


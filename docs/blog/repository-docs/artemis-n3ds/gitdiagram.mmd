node_user(("3DS user"))

node_user -->|"uses"| node_main
node_main -->|"finds hosts"| node_discovery
node_main -->|"pairs host"| node_pairing
node_main -.->|"manages host"| node_gamestream
node_gamestream -->|"parses responses"| node_xml
node_discovery -->|"uses records"| node_pairing
node_main -->|"shows menus"| node_ui
node_main -->|"lists apps"| node_appcache
node_main -->|"starts session"| node_connection
node_main -->|"loads settings"| node_config
node_main -->|"selects profile"| node_profiles
node_main -->|"handles controls"| node_input
node_input -->|"posts events"| node_dispatcher
node_input -->|"owns handlers"| node_touch
node_main -->|"dispatches events"| node_dispatcher
node_user -->|"opens helpers"| node_menuhub
node_menuhub -->|"posts actions"| node_dispatcher
node_menuhub -.->|"draws interface"| node_bottomui
node_user -->|"chooses stream"| node_connection
node_connection -.->|"receives video"| node_decoder
node_decoder -.->|"hardware path"| node_mvd
node_decoder -.->|"software path"| node_software
node_decoder -->|"renders frames"| node_renderer

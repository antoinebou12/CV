    </div>
  </dialog>

  <dialog class="publication-preview-dialog lens-preview-dialog" id="lens-preview-dialog" aria-labelledby="lens-preview-dialog-title" data-open-external-label="Open on lens.snap.com" data-open-popup-label="Open try-on window">
    <div class="publication-preview-dialog-panel lens-preview-dialog-panel">
      <button type="button" class="publication-preview-dialog-close" data-lens-preview-close aria-label="Close lens preview">&times;</button>
      <h3 id="lens-preview-dialog-title" class="lens-preview-dialog-heading"></h3>
      <div class="lens-preview-embed project-embed project-embed--lens">
        <iframe data-lens-preview-iframe title="" allow="camera; microphone" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="project-embed-note lens-preview-dialog-note">If the frame stays blank, lens.snap.com may block embedding. Use <strong>Open try-on window</strong> or <strong>Open on lens.snap.com</strong> below (allow camera on desktop).</p>
      <p class="lens-preview-dialog-actions">
        <button type="button" class="lens-preview-dialog-popup" data-lens-preview-popup>Open try-on window</button>
        <a href="" class="lens-preview-dialog-external" data-lens-preview-external target="_blank" rel="noopener noreferrer">Open on lens.snap.com</a>
      </p>
    </div>
  </dialog>

  <script>
    (function () {
      var dialog = document.getElementById('image-preview-dialog');
      if (!dialog) return;
      var dialogImg = dialog.querySelector('.publication-preview-dialog-img');
      var dialogCaption = dialog.querySelector('.publication-preview-dialog-caption');
      var dialogTitle = document.getElementById('image-preview-dialog-title');
      var dialogReport = document.getElementById('image-preview-dialog-report');
      var dialogReportLink = dialogReport ? dialogReport.querySelector('a') : null;
      var reportLabelDefault = dialog.getAttribute('data-report-label') || 'Open full report';

      function openPreview(btn) {
        var src = btn.getAttribute('data-image-preview-src');
        if (!src) {
          var thumb = btn.querySelector('img');
          if (thumb) src = thumb.getAttribute('src');
        }
        var alt = btn.getAttribute('data-image-preview-alt') || '';
        if (!alt) {
          var thumbAlt = btn.querySelector('img');
          if (thumbAlt) alt = thumbAlt.getAttribute('alt') || '';
        }
        var cap = btn.getAttribute('data-image-preview-caption');
        if (!cap) {
          var figure = btn.closest('figure');
          if (figure) {
            var fc = figure.querySelector('figcaption');
            if (fc) cap = fc.textContent.trim();
          }
        }
        var reportHref = btn.getAttribute('data-image-preview-report');
        var reportLabel = btn.getAttribute('data-image-preview-report-label') || reportLabelDefault;

        if (dialogImg && src) {
          dialogImg.src = src;
          dialogImg.alt = alt;
        }
        if (dialogCaption) {
          dialogCaption.textContent = cap || '';
          dialogCaption.hidden = !cap;
        }
        if (dialogTitle) dialogTitle.textContent = alt;
        if (dialogReport && dialogReportLink) {
          if (reportHref) {
            dialogReportLink.href = reportHref;
            dialogReportLink.textContent = reportLabel;
            dialogReport.hidden = false;
          } else {
            dialogReport.hidden = true;
          }
        }
        dialog.showModal();
      }

      document.querySelectorAll('[data-image-preview-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          openPreview(btn);
        });
      });
      dialog.querySelectorAll('[data-image-preview-close]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          dialog.close();
        });
      });
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });
    })();
  </script>

  <script>
    (function () {
      var dialog = document.getElementById('lens-preview-dialog');
      if (!dialog) return;
      var iframe = dialog.querySelector('[data-lens-preview-iframe]');
      var titleEl = document.getElementById('lens-preview-dialog-title');
      var externalLink = dialog.querySelector('[data-lens-preview-external]');
      var popupBtn = dialog.querySelector('[data-lens-preview-popup]');
      var currentUrl = '';
      var popupWindow = null;
      var openExternalLabel = dialog.getAttribute('data-open-external-label') || 'Open on lens.snap.com';
      var openPopupLabel = dialog.getAttribute('data-open-popup-label') || 'Open try-on window';

      function clearIframe() {
        if (iframe) iframe.removeAttribute('src');
      }

      function closeLensPreview() {
        dialog.close();
        clearIframe();
        currentUrl = '';
      }

      function openTryOnPopup(url) {
        if (!url || !isAllowedLensUrl(url)) return;
        var features = 'popup=yes,width=420,height=740,noopener,noreferrer';
        if (popupWindow && !popupWindow.closed) {
          try {
            popupWindow.location.href = url;
            popupWindow.focus();
            return;
          } catch (e) { /* cross-origin or closed */ }
        }
        popupWindow = window.open(url, 'snapLensTryOn', features);
      }

      function isAllowedLensUrl(url) {
        try {
          var parsed = new URL(url, window.location.href);
          return parsed.protocol === 'https:' && parsed.hostname === 'lens.snap.com';
        } catch (e) {
          return false;
        }
      }

      function openLensPreview(btn) {
        var url = btn.getAttribute('data-lens-preview-url');
        var title = btn.getAttribute('data-lens-preview-title') || 'Lens preview';
        if (!url || !isAllowedLensUrl(url)) return;
        currentUrl = url;
        if (titleEl) titleEl.textContent = title;
        if (iframe) {
          iframe.setAttribute('title', title + ' — try lens');
          iframe.setAttribute('src', url);
        }
        if (externalLink) {
          externalLink.href = url;
          externalLink.textContent = openExternalLabel;
        }
        if (popupBtn) popupBtn.textContent = openPopupLabel;
        dialog.showModal();
      }

      document.querySelectorAll('[data-lens-preview-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          openLensPreview(btn);
        });
      });
      dialog.querySelectorAll('[data-lens-preview-close]').forEach(function (btn) {
        btn.addEventListener('click', closeLensPreview);
      });
      if (popupBtn) {
        popupBtn.addEventListener('click', function () {
          openTryOnPopup(currentUrl);
        });
      }
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) closeLensPreview();
      });
      dialog.addEventListener('close', clearIframe);
    })();
  </script>

  <script>
    (function () {
      function isAllowedPreviewSrc(url) {
        try {
          var parsed = new URL(url, window.location.href);
          if (parsed.protocol !== 'https:') return false;
          var host = parsed.hostname;
          return host === 'www.youtube.com' || host === 'www.youtube-nocookie.com'
            || host === 'graphquon.github.io' || host === 'lens.snap.com';
        } catch (e) {
          return false;
        }
      }
      function loadProjectPreviewIframe(details) {
        if (!details.open) return;
        var iframe = details.querySelector('iframe[data-src]');
        if (!iframe || iframe.getAttribute('src')) return;
        var src = iframe.getAttribute('data-src');
        if (!isAllowedPreviewSrc(src)) return;
        iframe.setAttribute('src', src);
      }
      document.querySelectorAll('details.project-preview').forEach(function (el) {
        el.addEventListener('toggle', function () {
          loadProjectPreviewIframe(el);
        });
      });
    })();
  </script>


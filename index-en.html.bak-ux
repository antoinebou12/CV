          <div id="text-header">
            <h1><span class="butter-name"><span class="butter-word" style="--i:0">Antoine</span> <span class="butter-word" style="--i:1">Boucher</span></span><br><span class="butter-role"><span class="butter-word" style="--i:4">Software</span> <span class="butter-word" style="--i:5">Engineer</span> · <span class="butter-word" style="--i:7">Platform</span> <span class="butter-word" style="--i:8">and</span> <span class="butter-word" style="--i:10">graphics</span></span></h1>
            <p class="hero-place">Montréal, Québec</p>
            <div class="hero-actions">
              <a href="cv-en/resume.pdf" download class="btn btn-primary">
                Download CV
              </a>

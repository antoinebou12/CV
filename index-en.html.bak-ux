              name: 'open_cv_pdf',
              description: 'Open the public CV PDF (English or French) in a new browser tab.',
              inputSchema: {
                type: 'object',
                properties: {
                  lang: { type: 'string', enum: ['en', 'fr'], description: 'CV language' }
                },
                required: ['lang']
              },
              execute: function (args) {
                var lang = args && args.lang === 'fr' ? 'fr' : 'en';
                var path = lang === 'fr' ? 'cv-fr/resume.pdf' : 'cv-en/resume.pdf';
                window.open(path, '_blank', 'noopener,noreferrer');

{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Per-language sitemap: every page, including tag pages and the tag index, with hreflang on
       the short language code (matches the page <head>), x-default on the English page and real
       lastmod values. Only pages marked sitemap_exclude or sitemap.disable are left out. */ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $pages := .Pages }}
  {{- /* Search is built with list: never, so it is not in .Pages; it is still a public page. */}}
  {{- with site.GetPage "/search" }}{{ if not (in $pages .) }}{{ $pages = $pages | append . }}{{ end }}{{ end }}
  {{- range $pages }}
  {{- $skip := false }}
  {{- if or .Params.sitemap_exclude (eq .Sitemap.Disable true) }}{{ $skip = true }}{{ end }}
  {{- if not $skip }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}" />
    {{- end }}
    {{- $default := index (where .AllTranslations "Lang" "en") 0 | default . }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $default.Permalink }}" />
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>

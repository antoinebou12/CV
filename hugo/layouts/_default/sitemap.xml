{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Per-language sitemap: hreflang uses the short language code (matches the page <head>),
       adds x-default on the English page, keeps real lastmod values and leaves out tag pages that
       list a single entry (they add noise without new content). */ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Pages }}
  {{- $skip := false }}
  {{- if eq .Kind "term" }}{{ if lt (len .Pages) 2 }}{{ $skip = true }}{{ end }}{{ end }}
  {{- if eq .Kind "taxonomy" }}{{ $skip = true }}{{ end }}
  {{- if or .Params.sitemap_exclude (eq .Sitemap.Disable true) }}{{ $skip = true }}{{ end }}
  {{- if not $skip }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}" />
    {{- end }}
    {{- $default := index (where .AllTranslations "Lang" "en") 0 | default . }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $default.Permalink }}" />
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>

{
  "$schema": "https://antoineboucher.info/CV/design/tokens.schema.json",
  "meta": {
    "name": "Antoine Boucher portfolio spine",
    "version": 1,
    "strategy": "shared-spine-different-density",
    "notes": "CV hero stays Experience/Persuade (Fraunces). Project docs (.repo-doc) stay Read/Operate (system UI, no Fraunces)."
  },
  "breakpoints": {
    "sm": "390px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px"
  },
  "radius": {
    "sm": "4px",
    "md": "7px",
    "lg": "10px"
  },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "color": "#227c74"
  },
  "motion": {
    "ease-out": "cubic-bezier(.16, 1, .3, 1)",
    "ease-in-out": "cubic-bezier(.455, .03, .515, .955)",
    "ease-editorial": "cubic-bezier(.22, 1, .36, 1)",
    "duration-fast": "180ms",
    "duration-enter": "640ms",
    "duration-ignite": "1s"
  },
  "typography": {
    "display": {
      "family": "'Fraunces', Georgia, serif",
      "weight": 500,
      "size": "clamp(34px, 4.6vw, 60px)",
      "lineHeight": 1.08,
      "surfaces": ["cv-hero", "journal-article"]
    },
    "body": {
      "family": "'Open Sans', system-ui, sans-serif",
      "size": "16px",
      "lineHeight": 1.65,
      "measure": "65ch"
    },
    "docs": {
      "family": "system-ui, -apple-system, 'Segoe UI', sans-serif",
      "size": "16px",
      "lineHeight": 1.7,
      "measure": "65ch",
      "codeFamily": "ui-monospace, SFMono-Regular, Consolas, monospace",
      "codeSize": "13px"
    }
  },
  "colors": {
    "spine": {
      "accent": "#227c74",
      "accent-soft": "#006a62",
      "ink": "#192a3c",
      "muted": "#3d4f5f",
      "focus": "#227c74"
    },
    "hero": {
      "canvas": "oklch(0.398 0.047 248)",
      "paper": "oklch(0.985 0.006 190)",
      "ink": "oklch(0.31 0.035 240)",
      "muted": "oklch(0.40 0.028 240)",
      "accent": "oklch(0.445 0.073 181)",
      "soft": "oklch(0.956 0.012 190)",
      "rule": "oklch(0.85 0.017 210)",
      "glow": "#4cc7f0"
    },
    "docs": {
      "light": {
        "bg": "#f7f9fc",
        "panel": "#ffffff",
        "panel2": "#eef2f6",
        "line": "#c5d0db",
        "text": "#192a3c",
        "muted": "#3d4f5f",
        "accent": "#006a62",
        "accent2": "#0b5f9a",
        "chip": "#e4eef0",
        "code": "#f0f4f7",
        "warn": "#6b4504"
      },
      "dark": {
        "bg": "#0a1019",
        "panel": "#111c2a",
        "panel2": "#172637",
        "line": "#3a4d63",
        "text": "#edf4fb",
        "muted": "#c2d0de",
        "accent": "#6fdbd0",
        "accent2": "#acd5ff",
        "chip": "#1b3040",
        "code": "#091824",
        "warn": "#ffdaa0"
      }
    },
    "chart": ["#006a62", "#0b5f9a", "#8a5a00", "#5b4b8a", "#1f6f4a", "#8b3a4a"]
  },
  "components": {
    "badge": {
      "padding": "4px 10px",
      "radius": "7px",
      "fontSize": "12px"
    },
    "button": {
      "minHeight": "44px",
      "padding": "10px 18px",
      "radius": "4px"
    },
    "navPill": {
      "minHeight": "44px",
      "radius": "5px",
      "padding": "10px 15px"
    }
  }
}
